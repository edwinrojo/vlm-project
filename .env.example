# API origin (no trailing slash). Local dev with Vite proxy:
VITE_API_BASE_URL=/api

# Live backend (e.g. ngrok):
# VITE_API_BASE_URL=https://nonintrospective-remington-unquayed.ngrok-free.dev

VITE_USE_MOCK=true

# Base URL for detection images (file_name is appended)
# VITE_IMAGE_DETECTION_PATH=https://your-api.example.com/images

# Optional path overrides (defaults shown)
# VITE_ANALYTICS_PATH=/get-road-report
# VITE_DETECT_PATH=/road-check
